# Public URL used for canonical links, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://ahtshamlabs.pro

# Contact form delivery (optional). Without these, the form falls back to opening the visitor's email app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@ahtshamlabs.pro
# Must be a sender on a domain verified in Resend
CONTACT_FROM_EMAIL=Ahtsham Labs Website <website@ahtshamlabs.pro>
